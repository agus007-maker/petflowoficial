{
  "include": [
    "client/**/*.ts",
    "client/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "drizzle/**/*.ts",
    "lib/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "netlify/functions/**/*.ts",
    "netlify/functions/**/*.mts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "esnext",
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./client/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "target": "ES2017",
    "resolveJsonModule": true,
    "isolatedModules": true
  }
}
